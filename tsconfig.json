{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "ts-node": {
    "files": true
  },
  "include": [
    "src/**/*.ts",
    "__test__/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
